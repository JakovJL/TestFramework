<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Test Automation Suite" parallel="methods" thread-count="1">

    <listeners>
        <listener class-name="com.testframework.listeners.TestListener"/>
    </listeners>

    <test name="Welcome Page Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.testframework.tests.ui.WelcomePageUiTest"/>
        </classes>
    </test>

    <test name="API Tests">
        <classes>
            <class name="com.testframework.tests.api.AirportsApiTest"/>
        </classes>
    </test>

</suite>