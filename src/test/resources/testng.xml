<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Test Automation Suite" parallel="methods" thread-count="3">
    
    <listeners>
        <listener class-name="com.testframework.listeners.TestListener"/>
    </listeners>

    <test name="Welcome Page Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.testframework.tests.ui.WelcomePageTest"/>
        </classes>
    </test>

</suite>
